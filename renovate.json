{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "development"
  ],
  "useBaseBranchConfig": "merge",
  "reviewers": ["ghdrope"],
  "labels": ["renovate"],
  "packageRules": [
    {
      "reviewers": ["ghdrope"],
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "GitHub Workflows",
      "commitMessageTopic": "GitHub Workflows"
    },
    {
      "matchFileNames": [
        "go.**"
      ],
      "groupName": "Go Packages",
      "commitMessageTopic": "Go Packages"
    }
  ]
}
